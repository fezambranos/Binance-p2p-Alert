{
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": "web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/calc/sw.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, max-age=0" }
        ]
      },
      {
        "source": "/calc/manifest.webmanifest",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, max-age=0" },
          { "key": "Content-Type", "value": "application/manifest+json" }
        ]
      },
      {
        "source": "/calc/index.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, max-age=0" }
        ]
      }
    ]
  }
}
